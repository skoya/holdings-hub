{
  "name": "holdings-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "Holdings Hub Prototype — fictional GSIB-neutral digital asset simulation SPA (Meridian Bank). Simulation only — no real transactions or investment advice.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/engine tests/schemas tests/persistence",
    "test:watch": "vitest",
    "audit:deps": "audit-ci --moderate",
    "test:integration": "vitest run tests/integration",
    "e2e": "playwright test",
    "check:schemas": "vitest run tests/config",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "i18n:generate": "node scripts/translate.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@xyflow/react": "^12.12.0",
    "d3-force": "^3.0.0",
    "i18next": "^26.5.11",
    "jszip": "^3.10.2",
    "localforage": "^1.10.0",
    "pure-rand": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
